# ============================================================================
# MULE SHIELD Enterprise Environment Configuration Template
# COPY this file to .env and configure your actual project values.
# NEVER commit .env to version control or expose privileged secret keys.
# ============================================================================

# Analytical Backend Server (Python Engine)
HOST=127.0.0.1
PORT=8000
BACKEND_PORT=8000

# Frontend Web Application Server (Node Proxy)
FRONTEND_PORT=3000

# ============================================================================
# SUPABASE POSTGRESQL & STORAGE CONFIGURATION
# Obtain credentials from your Supabase Project Dashboard -> Settings -> API
# ============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Backward-compatibility alias for privileged secret key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# ============================================================================
# CLOUD DEPLOYMENT & PRODUCTION CORS CONFIGURATION
# ============================================================================
# Comma-separated list of permitted frontend origins for production CORS (Backend)
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,https://your-custom-domain.com

# Production Backend API URL (Frontend build-time variable for Vercel/Netlify)
MULE_SHIELD_API_URL=https://your-backend-service.onrender.com

# ============================================================================
# MASTER AI AGENT & HUGGING FACE INFERENCE CONFIGURATION
# Model: openai/gpt-oss-120b via Hugging Face Inference API
# Three-key automatic priority fallback: Primary -> Fallback 1 -> Fallback 2
# ============================================================================
HF_MODEL_ID=openai/gpt-oss-120b
HF_API_KEY_1=your_first_new_key
HF_API_KEY_2=your_second_new_key
HF_API_KEY_3=your_third_new_key
# Optional custom inference router endpoint (defaults to https://router.huggingface.co/hf-inference/v1/chat/completions)
# HF_INFERENCE_URL=https://router.huggingface.co/hf-inference/v1/chat/completions
